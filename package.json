{
  "name": "arthosrot",
  "version": "0.1.0",
  "private": true,
  "description": "Paper-trading platform with external broker-managed execution",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "next dev",
    "dev:worker": "tsx watch src/worker/main.ts",
    "start:worker": "tsx src/worker/main.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:external": "vitest run --config vitest.external.config.ts",
    "db:up": "docker compose up -d",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "test:int": "TEST_DB=1 vitest run tests/integration",
    "check:contrast": "tsx scripts/check-contrast.ts",
    "db:sync-instruments": "tsx scripts/sync-instruments.ts",
    "jobs:run": "tsx scripts/jobs-run.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.104.5",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "better-auth": "^1.7.13",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.4",
    "lightweight-charts": "^5.2.1",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.3.0",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.10"
  }
}
