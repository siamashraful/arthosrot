# Arthosrot environment configuration.
# Copy to .env.local. Next.js loads it for the web app; the worker and the
# pnpm db:* / jobs:run scripts (tsx) read the shell environment only, so export
# it first: set -a; . ./.env.local; set +a
# Every variable is documented here; docs/architecture/DEPLOYMENT.md covers per-environment values.
# NEVER commit real secrets.

# --- Runtime -----------------------------------------------------------------
# node environment: development | test | production
NODE_ENV=development

# --- Database ----------------------------------------------------------------
# Postgres connection string. Local default matches docker-compose.yml.
DATABASE_URL=postgres://arthosrot:arthosrot@localhost:5432/arthosrot

# --- Auth --------------------------------------------------------------------
# Secret for Better Auth session signing. Generate: openssl rand -base64 32
# (min 16 chars — shorter values fail env validation)
BETTER_AUTH_SECRET=dev-only-change-me-0000000000
# Canonical public origin — REQUIRED in deployed environments so auth origin
# checks never trust the request's own Host header. Leave unset for localhost.
# BETTER_AUTH_URL=https://arthosrot.vercel.app

# --- Providers ---------------------------------------------------------------
# Broker implementation: deterministic | alpaca-paper
# deterministic = offline, fixture-driven venue (default for local dev, tests, CI)
BROKER_PROVIDER=deterministic

# Market data implementation: fixture | alpaca
MARKET_DATA_PROVIDER=fixture

# --- Alpaca (only required when the providers above are set to alpaca*) ------
# Broker API *sandbox* credentials (broker-app.alpaca.markets — firm-level, server-side only)
ALPACA_BROKER_KEY=
ALPACA_BROKER_SECRET=
# Market Data API credentials (free IEX feed, from a Trading API account)
ALPACA_DATA_KEY=
ALPACA_DATA_SECRET=

# --- Trading configuration ---------------------------------------------------
# Onboarding starting-cash bounds (whole dollars). The user picks an amount
# in [MIN, MAX] on the onboarding slider; DEFAULT seeds it. MAX must stay
# <= 50000 — the Alpaca sandbox caps transfers at $50k/account/day
# (docs/architecture/INTEGRATIONS.md).
STARTING_CASH_MIN=1000
STARTING_CASH_MAX=25000
STARTING_CASH_DEFAULT=10000
# Conservative reservation buffer applied to market BUY orders (fraction, e.g. 0.025 = 2.5%)
MARKET_BUY_BUFFER=0.025

# --- Operational -------------------------------------------------------------
# Shared secret guarding the worker's POST /reconcile and POST /jobs/tick
# endpoints (min 16 chars). Generate: openssl rand -hex 32
CRON_SECRET=dev-only-change-me-0000000000
# SEC EDGAR fair-access User-Agent for the Top 100 ranking job: a name plus a
# contact email, e.g. "Arthosrot ops@yourdomain.com". Unset = the job is
# disabled (dev/CI never call SEC). SEC answers anonymous agents with 403.
# Set it on the web too: the instrument page's P/E fetches trailing EPS.
# SEC_USER_AGENT=
# How often the Top 100 recomputes: <n>m | <n>h | <n>d (default 24h). The
# worker's hourly tick bounds the granularity to ~1 hour.
# TOP100_REFRESH_INTERVAL=24h
# How often the price-alerts job evaluates active alerts: <n>m | <n>h | <n>d
# (default 5m). It runs only when the worker is ticked, so the effective
# cadence is max(this, the tick). Dev needs no worker: loading your alerts
# (or the bell's poll) evaluates them (ADR-016).
# ALERTS_CHECK_INTERVAL=5m
# Worker HTTP port (Render sets PORT automatically)
PORT=8090

# --- Development conveniences ------------------------------------------------
# Pin the fixture market OPEN so the deterministic venue fills outside real
# market hours. Dev/test only — never set in a deployed environment.
FORCE_MARKET_OPEN=0

# Stock logos: keyless public CDN template ({SYMBOL} placeholder), proxied and
# cached server-side. Uncomment to see real logos in local dev (production sets
# it). Unset = monogram chips everywhere — the CI default, so tests never touch
# the network.
# LOGO_UPSTREAM=https://assets.parqet.com/logos/symbol/{SYMBOL}?format=png
